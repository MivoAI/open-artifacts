{
  "name": "@open-artifacts/markdown-editor",
  "version": "0.1.0",
  "description": "A source-first Markdown editor Artifact with precise block-range annotation targets.",
  "type": "module",
  "files": [
    "src",
    "input.schema.json",
    "example.json",
    "tsconfig.json",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./activate": "./src/activate.ts",
    "./schema": "./input.schema.json",
    "./example": "./example.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "openArtifacts": {
    "format": "react-runtime/v1"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "tsc --project tsconfig.check.json"
  },
  "peerDependencies": {
    "@open-artifacts/sdk": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^5.8.3"
  }
}
