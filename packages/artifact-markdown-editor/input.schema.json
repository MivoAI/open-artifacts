{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Markdown Editor Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "markdown"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "markdown": {
      "type": "string"
    }
  }
}
